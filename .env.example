# Copy to .env and fill in. .env is git-ignored.

# Modo Energy API
MODO_API_TOKEN=

# Snowflake (programmatic access token)
SNOWFLAKE_ACCOUNT=<org>-<account>
SNOWFLAKE_USER=
SNOWFLAKE_TOKEN=
SNOWFLAKE_ROLE=ACCOUNTADMIN
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=SNOWFLAKE_CURATED_DATA_CORE_WEATHER_DATA
SNOWFLAKE_SCHEMA=PUBLIC_DATA
